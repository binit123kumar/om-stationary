.logo{display:grid;grid-template-columns:38px auto;align-items:center;column-gap:7px}.logo span{grid-row:1 / span 2;width:38px;height:38px;display:grid;place-items:center;margin:0;border-radius:13px;background:#103f76;color:#fff;font-size:15px;letter-spacing:-1px}.logo small{grid-column:2;font-size:8px;margin-top:2px}.purchase-actions{display:flex;gap:10px;margin-top:15px}.purchase-actions .btn,.purchase-actions .outline{flex:1}.whatsapp-link{display:flex!important;align-items:center;gap:6px}.inventory-shop{border-top:1px solid #e9edf2;padding:12px 0}.inventory-shop summary{cursor:pointer;font-weight:800}.inventory-shop summary small{font-weight:500;color:#6c7b8f;margin-left:8px}.inventory-inner{padding:10px 0}.inventory-form{display:grid;grid-template-columns:1.4fr 1fr .8fr auto;gap:10px;align-items:end;margin-top:14px}.inventory-form .field-label{min-width:0}.inventory-form .btn{white-space:nowrap}@media(max-width:650px){.inventory-form{grid-template-columns:1fr 1fr}.inventory-form .btn{grid-column:1/-1;width:100%}.purchase-actions{flex-direction:column}.top .logo{margin-right:auto}}
.order-lookup{display:flex;justify-content:center;margin:0 0 28px}.order-lookup form{display:flex;align-items:end;gap:10px;width:min(100%,680px);margin:0}.order-lookup .field-label{flex:1}.recent-orders{background:#fff;border:1px solid #e8edf4;border-radius:14px;padding:0 16px}.recent-order{display:grid;grid-template-columns:1fr auto 20px;gap:18px;align-items:center;padding:16px 0;border-bottom:1px solid #edf0f4}.recent-order:last-child{border:0}.recent-order>div{display:flex;flex-direction:column;gap:4px}.recent-order span{font-size:12px;color:#718096}.recent-order>svg{color:#8091a5}@media(max-width:650px){.order-lookup form{flex-direction:column;align-items:stretch}.order-lookup form .btn{width:100%}.recent-order{gap:10px}}
.card{position:relative}.wishlist-toggle{position:absolute;z-index:1;top:9px;right:9px;display:grid;place-items:center;width:34px;height:34px;border:1px solid #e1e6ed;border-radius:50%;background:#fff;color:#66758a;cursor:pointer;box-shadow:0 3px 12px #17203318}.wishlist-toggle.saved,.wishlist-detail{color:#c94c5a}.wishlist-detail{border:1px solid #f1d6db;background:#fff;border-radius:10px;padding:9px 13px;display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer}.purchase-actions .btn,.purchase-actions .outline,.purchase-actions .wishlist-detail{min-height:43px}

/* --- Notifications, content pages and admin tables --- */
.badge{min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:#ff6b0a;color:#fff;font-size:11px;font-weight:800;display:inline-flex;align-items:center;justify-content:center}
.notification-list{display:flex;flex-direction:column;gap:12px;max-width:860px}
.notification{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;background:#fff;border:1px solid #e7e8ee;border-radius:16px;padding:18px 20px}
.notification.unread{border-color:#ff6b0a;background:#fffaf5}
.notification b{display:block;margin-bottom:5px}
.notification p{margin:0 0 6px;color:#4b5563}
.notification small{color:#8a93a2}
.content-prose{max-width:820px;background:#fff;border:1px solid #e7e8ee;border-radius:18px;padding:28px 30px;margin-bottom:60px}
.content-prose h2{font-size:19px;margin:26px 0 10px}
.content-prose h2:first-child{margin-top:0}
.content-prose p,.content-prose li{color:#4b5563;line-height:1.7}
.content-prose ul{padding-left:20px}
.content-prose .muted{color:#8a93a2;font-size:13px;margin-top:26px}
.contact-layout{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:60px}
.faq-list{display:flex;flex-direction:column;gap:12px;max-width:860px}
.faq{background:#fff;border:1px solid #e7e8ee;border-radius:14px;padding:18px 20px}
.faq summary{cursor:pointer;font-weight:700}
.faq p{margin:12px 0 0;color:#4b5563;line-height:1.7}
.help-cta{margin:24px 0 60px;max-width:860px}
.admin-table{width:100%;border-collapse:collapse;font-size:14px}
.admin-table th{text-align:left;padding:10px 12px;border-bottom:2px solid #e7e8ee;color:#6b7280;font-size:12px;text-transform:uppercase;letter-spacing:.4px}
.admin-table td{padding:12px;border-bottom:1px solid #eee;vertical-align:middle}
.admin-table td small{display:block;color:#8a93a2;font-size:12px;margin-top:3px}
.admin-table .low-stock{color:#dc2626;font-weight:800}
.admin-table button{margin-right:6px;padding:6px 10px;font-size:12px}
@media(max-width:800px){.contact-layout{grid-template-columns:1fr}.content-prose{padding:22px 18px}.admin-table{display:block;overflow-x:auto}}
/* =========================================================
   OM STATIONARY � 3D GLASS ACCOUNT EXPERIENCE
   Login / Register / Customer Dashboard
   ========================================================= */

:root{
  --om-bg:#07111f;
  --om-bg2:#0d1b31;
  --om-card:rgba(17,31,55,.72);
  --om-card2:rgba(28,47,82,.62);
  --om-border:rgba(255,255,255,.14);
  --om-text:#f7f9ff;
  --om-muted:#aebbd1;
  --om-blue:#238cff;
  --om-purple:#8b5cf6;
  --om-cyan:#22d3ee;
  --om-pink:#ec4899;
  --om-shadow:0 25px 70px rgba(0,0,0,.42);
}

/* ---------- GLOBAL ACCOUNT BACKGROUND ---------- */

.account-page,
.account{
  position:relative;
  isolation:isolate;
  min-height:calc(100vh - 120px);
  padding:48px 24px;
  overflow:hidden;
  background:
    radial-gradient(circle at 8% 15%,rgba(35,140,255,.20),transparent 28%),
    radial-gradient(circle at 88% 18%,rgba(139,92,246,.22),transparent 28%),
    radial-gradient(circle at 50% 100%,rgba(34,211,238,.12),transparent 35%),
    linear-gradient(135deg,#050b16 0%,#0b1729 48%,#10182e 100%);
}

/* floating 3D light spheres */

.account-page::before,
.account::before{
  content:"";
  position:absolute;
  width:360px;
  height:360px;
  border-radius:50%;
  top:35px;
  left:-130px;
  z-index:-1;
  background:
    radial-gradient(circle at 32% 28%,#fff 0 2%,#60a5fa 5%,#2563eb 24%,transparent 62%);
  filter:blur(1px);
  opacity:.34;
  box-shadow:
    80px 100px 100px rgba(37,99,235,.18),
    inset -30px -30px 70px rgba(0,0,0,.35);
  animation:omFloat 8s ease-in-out infinite;
}

.account-page::after,
.account::after{
  content:"";
  position:absolute;
  width:280px;
  height:280px;
  border-radius:42%;
  right:-100px;
  bottom:-80px;
  z-index:-1;
  transform:rotate(22deg);
  background:
    linear-gradient(135deg,
      rgba(139,92,246,.55),
      rgba(35,140,255,.15));
  border:1px solid rgba(255,255,255,.10);
  box-shadow:
    0 30px 100px rgba(139,92,246,.25),
    inset 15px 15px 50px rgba(255,255,255,.10);
  animation:omCube 10s ease-in-out infinite;
}

@keyframes omFloat{
  0%,100%{transform:translate3d(0,0,0) scale(1)}
  50%{transform:translate3d(35px,25px,0) scale(1.08)}
}

@keyframes omCube{
  0%,100%{transform:rotate(22deg) translateY(0)}
  50%{transform:rotate(35deg) translateY(-28px)}
}

/* ---------- LOGIN / REGISTER ---------- */

.account-page{
  display:grid;
  grid-template-columns:minmax(280px,1fr) minmax(360px,520px);
  align-items:center;
  gap:60px;
  max-width:1450px;
  margin:auto;
}

.account-page::marker{
  display:none;
}

.account-page > .panel{
  position:relative;
}

/* Add visual 3D stationery environment beside auth card */

.account-page > .panel.auth-panel::before{
  content:"OM";
  position:absolute;
  width:240px;
  height:240px;
  left:-330px;
  top:50%;
  transform:translateY(-50%) perspective(700px) rotateY(-18deg) rotateX(8deg);
  display:grid;
  place-items:center;
  border-radius:34px;
  font-size:82px;
  font-weight:900;
  letter-spacing:-6px;
  color:white;
  background:
    linear-gradient(145deg,rgba(255,255,255,.15),rgba(255,255,255,.025)),
    linear-gradient(135deg,#2563eb,#7c3aed);
  border:1px solid rgba(255,255,255,.20);
  box-shadow:
    25px 35px 70px rgba(0,0,0,.50),
    inset 10px 10px 35px rgba(255,255,255,.16),
    inset -15px -15px 35px rgba(0,0,0,.20);
  text-shadow:0 8px 25px rgba(0,0,0,.35);
  animation:omLogoFloat 6s ease-in-out infinite;
}

.account-page > .panel.auth-panel::after{
  content:"?   ?   ?";
  position:absolute;
  left:-285px;
  bottom:30px;
  font-size:28px;
  letter-spacing:18px;
  color:#67e8f9;
  transform:rotate(-8deg);
  filter:drop-shadow(0 8px 20px rgba(34,211,238,.45));
  animation:omPens 5s ease-in-out infinite;
}

@keyframes omLogoFloat{
  0%,100%{transform:translateY(-50%) perspective(700px) rotateY(-18deg) rotateX(8deg)}
  50%{transform:translateY(calc(-50% - 18px)) perspective(700px) rotateY(-10deg) rotateX(4deg)}
}

@keyframes omPens{
  0%,100%{transform:rotate(-8deg) translateX(0)}
  50%{transform:rotate(-3deg) translateX(15px)}
}

/* Glass auth card */

.auth-panel{
  width:100%;
  padding:42px;
  border-radius:30px;
  background:
    linear-gradient(145deg,
      rgba(255,255,255,.12),
      rgba(255,255,255,.035) 45%,
      rgba(13,27,49,.78));
  border:1px solid var(--om-border);
  box-shadow:
    var(--om-shadow),
    inset 1px 1px 0 rgba(255,255,255,.10);
  backdrop-filter:blur(24px) saturate(135%);
  -webkit-backdrop-filter:blur(24px) saturate(135%);
  transform:perspective(1200px) rotateX(1deg);
  transition:transform .35s ease,box-shadow .35s ease;
}

.auth-panel:hover{
  transform:perspective(1200px) rotateX(0) translateY(-4px);
  box-shadow:
    0 35px 90px rgba(0,0,0,.55),
    0 0 55px rgba(59,130,246,.10),
    inset 1px 1px 0 rgba(255,255,255,.13);
}

.auth-panel small{
  color:#67e8f9;
  font-weight:800;
  letter-spacing:2px;
}

.auth-panel h1{
  margin:10px 0 8px;
  color:var(--om-text);
  font-size:clamp(32px,4vw,48px);
  line-height:1.05;
  letter-spacing:-1.8px;
}

.auth-panel > p{
  color:var(--om-muted);
}

/* Form */

.account-form{
  margin-top:28px;
  display:grid;
  gap:17px;
}

.account-form label{
  display:grid;
  gap:8px;
  color:#dce7fa;
  font-weight:650;
  font-size:14px;
}

.account-form input{
  width:100%;
  min-height:52px;
  padding:0 16px;
  border-radius:15px;
  border:1px solid rgba(255,255,255,.14);
  outline:none;
  color:#fff;
  background:rgba(5,13,27,.62);
  box-shadow:
    inset 0 2px 8px rgba(0,0,0,.20),
    0 5px 20px rgba(0,0,0,.10);
  transition:.25s ease;
}

.account-form input::placeholder{
  color:#8190aa;
}

.account-form input:focus{
  border-color:#38bdf8;
  background:rgba(10,24,46,.82);
  box-shadow:
    0 0 0 4px rgba(56,189,248,.10),
    0 10px 30px rgba(0,0,0,.22);
  transform:translateY(-1px);
}

.auth-panel .btn.wide{
  min-height:54px;
  border:0;
  border-radius:15px;
  color:#fff;
  font-weight:800;
  background:
    linear-gradient(110deg,#8b5cf6 0%,#6366f1 42%,#168cff 100%);
  box-shadow:
    0 12px 30px rgba(37,99,235,.32),
    inset 0 1px 0 rgba(255,255,255,.28);
  transition:.25s ease;
}

.auth-panel .btn.wide:hover{
  transform:translateY(-3px);
  box-shadow:
    0 18px 42px rgba(37,99,235,.42),
    0 0 30px rgba(139,92,246,.18);
}

.account-switch{
  margin-top:22px;
  text-align:center;
  color:#9fb0c9;
}

.account-switch a{
  color:#67e8f9;
  font-weight:800;
  text-decoration:none;
}

.account-switch a:hover{
  color:#a78bfa;
}

/* Error */

.form-error{
  border-radius:14px;
  padding:12px 15px;
  color:#fecaca;
  background:rgba(127,29,29,.35);
  border:1px solid rgba(248,113,113,.25);
}

/* ---------- CUSTOMER DASHBOARD / ACCOUNT ---------- */

.account:not(.auth-panel){
  color:var(--om-text);
}

.account > .panel{
  background:
    linear-gradient(145deg,
      rgba(20,39,68,.84),
      rgba(9,21,39,.76));
  border:1px solid rgba(255,255,255,.11);
  border-radius:24px;
  box-shadow:
    0 25px 70px rgba(0,0,0,.38),
    inset 1px 1px 0 rgba(255,255,255,.07);
  backdrop-filter:blur(18px);
  transition:.3s ease;
}

.account > .panel:hover{
  transform:translateY(-4px);
  box-shadow:
    0 35px 90px rgba(0,0,0,.48),
    0 0 40px rgba(59,130,246,.08);
}

/* Existing dashboard cards */

.account .panel,
.account .card,
.account .account-card,
.account .address-card,
.account .order-card,
.account .stat-card,
.account .profile-card{
  border-color:rgba(255,255,255,.11);
  background:
    linear-gradient(145deg,
      rgba(25,45,78,.72),
      rgba(8,20,38,.72));
  box-shadow:
    0 18px 45px rgba(0,0,0,.26),
    inset 1px 1px 0 rgba(255,255,255,.06);
  backdrop-filter:blur(14px);
}

/* 3D hover on dashboard cards */

.account .card:hover,
.account .account-card:hover,
.account .address-card:hover,
.account .order-card:hover,
.account .stat-card:hover,
.account .profile-card:hover{
  transform:translateY(-5px) perspective(900px) rotateX(1deg);
  border-color:rgba(96,165,250,.30);
  box-shadow:
    0 25px 55px rgba(0,0,0,.36),
    0 0 35px rgba(59,130,246,.08);
}

/* Dashboard headings */

.account h1,
.account h2,
.account h3{
  color:#f8fbff;
}

.account p,
.account small{
  color:#aebbd1;
}

/* Buttons */

.account .btn,
.account .outline{
  border-radius:13px;
  transition:.25s ease;
}

.account .btn:hover,
.account .outline:hover{
  transform:translateY(-2px);
}

/* Status pills */

.account .status,
.account .badge,
.account [class*="status"]{
  border-radius:999px;
}

/* ---------- 3D STAT ICONS ---------- */

.account .stat-icon,
.account .icon-box{
  display:grid;
  place-items:center;
  width:54px;
  height:54px;
  border-radius:17px;
  background:
    linear-gradient(145deg,
      rgba(96,165,250,.30),
      rgba(37,99,235,.10));
  border:1px solid rgba(96,165,250,.25);
  box-shadow:
    8px 10px 25px rgba(0,0,0,.28),
    inset 3px 3px 10px rgba(255,255,255,.08);
  transform:perspective(500px) rotateX(7deg) rotateY(-7deg);
}

/* ---------- RESPONSIVE ---------- */

@media(max-width:950px){
  .account-page{
    grid-template-columns:1fr;
    max-width:650px;
    gap:20px;
  }

  .account-page > .panel.auth-panel::before{
    display:none;
  }

  .account-page > .panel.auth-panel::after{
    display:none;
  }

  .auth-panel{
    padding:30px 24px;
  }
}

@media(max-width:600px){
  .account-page,
  .account{
    padding:28px 14px;
  }

  .auth-panel{
    border-radius:22px;
    padding:25px 18px;
  }

  .auth-panel h1{
    font-size:34px;
  }

  .account-page::before{
    width:220px;
    height:220px;
  }

  .account-page::after{
    width:180px;
    height:180px;
  }
}

/* Reduced motion */

@media(prefers-reduced-motion:reduce){
  *,
  *::before,
  *::after{
    animation:none !important;
    transition:none !important;
  }
}

/* ===== ACCOUNT DASHBOARD FINAL FIX ===== */
.account-page {
  width: 100%;
  min-height: calc(100vh - 160px);
  padding: 54px 24px 80px;
  box-sizing: border-box;
}

.account-page > .panel,
.account-page .account-panel {
  width: min(1200px, 100%);
  max-width: 1200px;
  margin: 0 auto;
}

.account-page .account-panel {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(240px, .7fr) minmax(280px, .85fr);
  gap: 18px;
  align-items: start;
  overflow: visible;
}

.account-page h1,
.account-page h2,
.account-page h3 {
  color: #ffffff !important;
}

.account-page p,
.account-page small,
.account-page label {
  color: #d9e5f5;
}

.account-page .account-hero,
.account-page .account-intro {
  color: #ffffff !important;
}

.account-page .account-hero p,
.account-page .account-intro p {
  color: #b9c8dc !important;
}

.account-page .panel,
.account-page .card,
.account-page .account-card,
.account-page .profile-card,
.account-page .address-card {
  box-sizing: border-box;
}

.account-page input,
.account-page select,
.account-page textarea {
  width: 100%;
  box-sizing: border-box;
}

.account-page button {
  min-height: 42px;
}

.account-page .account-form {
  width: 100%;
}

@media (max-width: 1000px) {
  .account-page .account-panel {
    grid-template-columns: 1fr 1fr;
  }

  .account-page .account-hero,
  .account-page .account-intro {
    grid-column: 1 / -1;
  }
}

@media (max-width: 680px) {
  .account-page {
    padding: 28px 14px 60px;
  }

  .account-page .account-panel {
    grid-template-columns: 1fr;
  }

  .account-page .account-hero,
  .account-page .account-intro {
    grid-column: auto;
  }
}

/* Improve readability on dark 3D background */
.account-page .form-error {
  color: #ffb4b4 !important;
}

.account-page .account-switch {
  color: #cbd8e8 !important;
}

.account-page a {
  color: #ff7a18;
}

.account-page a:hover {
  color: #ff9b52;
}

/* =========================================================
   OM STATIONARY - PROFESSIONAL ACCOUNT DASHBOARD
   ========================================================= */

.account-page {
  min-height: calc(100vh - 180px);
  padding: 34px 20px 70px !important;
}

.account-page > * {
  box-sizing: border-box;
}

/* Main dashboard glass container */
.account-page .panel {
  max-width: 1180px !important;
  width: 100% !important;
  margin: 0 auto !important;
}

/* Account main layout */
.account-page .account-panel {
  display: grid !important;
  grid-template-columns: minmax(280px, 1.15fr) minmax(240px, .72fr) minmax(300px, .88fr) !important;
  gap: 16px !important;
  align-items: start !important;
}

/* Hero / account information */
.account-page .account-intro,
.account-page .account-hero {
  min-height: 360px !important;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 38px !important;
}

.account-page .account-intro h1,
.account-page .account-hero h1 {
  font-size: clamp(30px, 3vw, 44px) !important;
  line-height: 1.08 !important;
  margin: 10px 0 14px !important;
  color: #fff !important;
}

.account-page .account-intro p,
.account-page .account-hero p {
  color: #b9c9dd !important;
  font-size: 14px !important;
}

/* Profile + address cards */
.account-page .account-card,
.account-page .profile-card,
.account-page .address-card,
.account-page .account-form {
  border-radius: 18px !important;
}

.account-page .profile-card,
.account-page .address-card {
  padding: 22px !important;
}

/* Compact form */
.account-page label {
  display: block;
  margin-bottom: 9px !important;
  font-size: 12px !important;
  font-weight: 600;
}

.account-page input,
.account-page select,
.account-page textarea {
  min-height: 38px !important;
  padding: 9px 11px !important;
  border-radius: 9px !important;
  font-size: 13px !important;
}

.account-page textarea {
  min-height: 70px !important;
}

/* Buttons */
.account-page button,
.account-page .btn {
  min-height: 38px !important;
  border-radius: 9px !important;
  font-size: 13px !important;
  font-weight: 700;
}

/* Save buttons */
.account-page .wide {
  width: 100%;
}

/* Address city/state row */
.account-page .account-form .row,
.account-page .address-form .row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

/* Saved addresses / orders section */
.account-page .saved-addresses,
.account-page .orders-section,
.account-page .account-orders {
  grid-column: 1 / -1 !important;
  width: 100% !important;
  margin-top: 2px !important;
}

/* Cards below main row */
.account-page .saved-addresses > *,
.account-page .orders-section > *,
.account-page .account-orders > * {
  box-sizing: border-box;
}

/* Links */
.account-page a {
  color: #ff7414;
  font-weight: 600;
  text-decoration: none;
}

.account-page a:hover {
  color: #ff9b52;
}

/* Logout */
.account-page button:not(.btn) {
  cursor: pointer;
}

/* Better desktop spacing */
@media (min-width: 1100px) {
  .account-page .account-panel {
    min-height: 420px;
  }
}

/* Tablet */
@media (max-width: 1000px) {
  .account-page .account-panel {
    grid-template-columns: 1fr 1fr !important;
  }

  .account-page .account-intro,
  .account-page .account-hero {
    grid-column: 1 / -1 !important;
    min-height: 280px !important;
  }
}

/* Mobile */
@media (max-width: 680px) {
  .account-page {
    padding: 22px 12px 50px !important;
  }

  .account-page .account-panel {
    grid-template-columns: 1fr !important;
    gap: 14px !important;
  }

  .account-page .account-intro,
  .account-page .account-hero,
  .account-page .saved-addresses,
  .account-page .orders-section,
  .account-page .account-orders {
    grid-column: auto !important;
  }

  .account-page .account-intro,
  .account-page .account-hero {
    min-height: 240px !important;
    padding: 26px !important;
  }

  .account-page .account-intro h1,
  .account-page .account-hero h1 {
    font-size: 30px !important;
  }
}

/* Prevent horizontal overflow */
.account-page,
.account-page * {
  max-width: 100%;
}

.account-page {
  overflow-x: hidden;
}

/* =========================================================
   OM STATIONARY - CUSTOMER FLOW / 3D PAYMENT EXPERIENCE
   ========================================================= */

.admin-top-button{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:8px 12px;
  border-radius:11px;
  background:linear-gradient(135deg,#ff6b00,#ff8a2b);
  color:#fff!important;
  font-weight:800;
  box-shadow:0 8px 22px rgba(255,107,0,.22);
  white-space:nowrap;
}
.admin-top-button:hover{transform:translateY(-2px);color:#fff!important}

.add-row{display:flex;gap:7px;align-items:center;margin-top:8px}
.qty-mini{display:flex;align-items:center;border:1px solid #dbe5f0;border-radius:9px;overflow:hidden;background:#fff}
.qty-mini button{width:28px;height:34px;border:0;background:#f4f7fb;color:#17304e;font-weight:800;cursor:pointer}
.qty-mini b{width:27px;text-align:center;font-size:12px}
.add-row .add{flex:1;margin-top:0}
.added-preview{display:inline-flex;min-width:18px;height:18px;align-items:center;justify-content:center;border-radius:50%;background:#fff;color:#ff6b00;font-size:11px;font-weight:900}

.auth-3d-page,.flow-auth-gate,.payment-3d-page{
  position:relative;
  min-height:calc(100vh - 180px);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:50px 20px 80px;
  overflow:hidden;
  background:
    radial-gradient(circle at 15% 20%,rgba(24,94,200,.25),transparent 30%),
    radial-gradient(circle at 85% 80%,rgba(124,76,220,.25),transparent 32%),
    linear-gradient(135deg,#061326,#10183a 55%,#081729);
}
.auth-3d-orb,.flow-orb{
  position:absolute;border-radius:50%;filter:blur(2px);pointer-events:none;
  box-shadow:0 0 80px rgba(49,139,255,.35);
}
.orb-a{width:330px;height:330px;background:radial-gradient(circle at 35% 30%,#2368d8,#07152c 70%);left:-100px;top:40px}
.orb-b{width:260px;height:260px;background:radial-gradient(circle at 35% 30%,#8c52e8,#111631 70%);right:-70px;bottom:20px}

.auth-3d-card,.flow-glass-card,.payment-glass{
  position:relative;z-index:2;width:min(480px,100%);padding:34px;
  border:1px solid rgba(255,255,255,.18);border-radius:28px;
  background:linear-gradient(145deg,rgba(255,255,255,.13),rgba(255,255,255,.055));
  box-shadow:0 30px 80px rgba(0,0,0,.42),inset 0 1px 0 rgba(255,255,255,.16);
  backdrop-filter:blur(24px);
  color:#fff;
  transform:perspective(1000px) rotateX(.5deg);
}
.auth-brand-3d{display:flex;align-items:center;gap:10px;margin-bottom:24px}
.auth-brand-3d>span{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:#0d4d92;color:#fff;font-weight:950;box-shadow:0 10px 25px rgba(18,103,197,.35)}
.auth-brand-3d b{display:block;font-size:14px;letter-spacing:.05em}
.auth-brand-3d small{display:block;color:#a9bdd6;font-size:9px}
.auth-kicker{color:#ff7b1a;font-weight:900;letter-spacing:.18em}
.auth-3d-card h1{font-size:34px;line-height:1.05;margin:8px 0 10px;color:#fff}
.auth-sub{color:#b8c9dd;margin-bottom:24px}
.auth-3d-form label{display:block;color:#dbe7f4;font-size:12px;font-weight:800;margin-bottom:12px}
.auth-3d-form input:not([type="checkbox"]){display:block;width:100%;box-sizing:border-box;margin-top:6px;padding:13px 14px;border:1px solid rgba(255,255,255,.14);border-radius:12px;background:rgba(255,255,255,.94);color:#142640;outline:0}
.auth-3d-form input:focus{box-shadow:0 0 0 3px rgba(50,145,255,.25)}
.auth-check{display:flex!important;align-items:center;gap:8px}
.auth-check input{width:auto!important;margin:0!important}
.auth-switch{margin-top:18px;text-align:center;color:#afc0d5}
.auth-switch a{color:#ff8a32;font-weight:900}

.success-modal-backdrop{
  position:fixed;inset:0;z-index:9999;display:grid;place-items:center;
  background:rgba(2,8,20,.72);backdrop-filter:blur(10px);
}
.success-modal{
  width:min(420px,calc(100% - 30px));padding:36px;border-radius:28px;
  text-align:center;background:#fff;color:#13223a;
  box-shadow:0 35px 100px rgba(0,0,0,.5);animation:successPop .35s ease-out;
}
.success-check{width:78px;height:78px;margin:0 auto 18px;border-radius:50%;display:grid;place-items:center;background:#e8f8ef;color:#1b9b57}
.success-modal small{font-weight:900;letter-spacing:.15em;color:#ff6b00}
.success-modal h2{font-size:28px;margin:8px 0}
.success-modal p{color:#607087}
@keyframes successPop{from{opacity:0;transform:translateY(15px) scale(.94)}to{opacity:1;transform:none}}

.checkout-flow-3d{
  width:min(1160px,calc(100% - 32px));margin:42px auto 80px;
  display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.65fr);gap:20px;
}
.flow-main-card,.flow-summary-card{
  border-radius:24px;padding:28px;background:#fff;
  box-shadow:0 20px 55px rgba(15,41,75,.12);border:1px solid #e5edf6;
}
.flow-main-card{background:linear-gradient(145deg,#08162c,#102b4d);color:#fff}
.flow-title small{color:#ff7b1a;font-weight:900;letter-spacing:.16em}
.flow-title h1{font-size:34px;margin:8px 0}
.flow-title p{color:#b9cbe0}
.payment-choice-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:24px 0}
.payment-choice{display:flex;align-items:center;gap:12px;padding:16px;border:1px solid rgba(255,255,255,.15);border-radius:16px;background:rgba(255,255,255,.06);cursor:pointer}
.payment-choice.selected{border-color:#ff791d;box-shadow:0 0 0 2px rgba(255,121,29,.18);background:rgba(255,121,29,.1)}
.payment-choice input{accent-color:#ff7414}
.payment-choice svg{color:#54a8ff}
.payment-choice span{display:flex;flex-direction:column;gap:3px}
.payment-choice small{color:#aebfd3}
.customer-details-3d{margin-top:22px;padding-top:22px;border-top:1px solid rgba(255,255,255,.1)}
.flow-fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.flow-fields label{font-size:12px;font-weight:800;color:#d9e6f5}
.flow-fields label:nth-child(4){grid-column:1/-1}
.flow-fields input{width:100%;box-sizing:border-box;margin-top:6px;padding:12px;border-radius:11px;border:1px solid #d9e5f0}
.flow-summary-card svg{color:#1764c0}
.flow-summary-card h3{margin:8px 0 18px}
.flow-item,.flow-total,.flow-grand{display:flex;justify-content:space-between;gap:12px;margin:11px 0;font-size:13px}
.flow-grand{font-size:19px;padding-top:12px;border-top:2px solid #e8eef5}
.flow-summary-card small{color:#708096}
.payment-glass{width:min(520px,100%);text-align:center}
.payment-head{display:flex;align-items:center;gap:14px;text-align:left}
.payment-icon{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;background:#0d5bb0}
.payment-head h1{margin:4px 0;font-size:30px}
.payment-amount{font-size:38px;font-weight:950;margin:20px 0}
.qr-shell{display:grid;place-items:center;padding:18px;background:#fff;border-radius:20px;width:max-content;margin:0 auto;box-shadow:0 18px 50px rgba(0,0,0,.3)}
.payment-upi,.payment-order{color:#c0d0e3}
.payment-warning{display:flex;gap:9px;text-align:left;padding:12px;border-radius:12px;background:rgba(255,178,60,.1);color:#f4d7a5;margin:16px 0}
.payment-warning svg{flex:none;color:#ffb23c}

.invoice-page{width:min(1050px,calc(100% - 28px));margin:35px auto 70px}
.invoice-actions{display:flex;justify-content:space-between;gap:10px;margin-bottom:16px}
.professional-invoice{background:#fff;border:1px solid #dce6f0;box-shadow:0 20px 60px rgba(17,40,68,.12);padding:35px;color:#182b43}
.invoice-header{display:flex;justify-content:space-between;gap:20px;padding-bottom:22px;border-bottom:2px solid #163f76}
.invoice-logo{font-size:32px;font-weight:950;color:#0e4e92}.invoice-logo span{color:#ff7414}
.invoice-header b,.invoice-header small{display:block}
.invoice-header small{color:#69788b}
.invoice-title{text-align:right}.invoice-title h1{margin:5px 0;font-size:24px}
.invoice-meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px;padding:24px 0}
.invoice-meta-grid p{font-size:12px;line-height:1.6;color:#596a7f}
.invoice-table{width:100%;border-collapse:collapse;font-size:12px}
.invoice-table th,.invoice-table td{border:1px solid #d9e2eb;padding:9px;text-align:left}
.invoice-table th{background:#edf3f9}
.invoice-bottom{display:flex;justify-content:space-between;gap:30px;margin-top:25px}
.invoice-totals{min-width:280px}
.invoice-totals p{display:flex;justify-content:space-between}
.invoice-grand{font-size:18px;border-top:2px solid #183f72;padding-top:10px}
.professional-invoice footer{margin-top:28px;padding-top:15px;border-top:1px solid #dce5ee;text-align:center;color:#718096;font-size:11px}

@media(max-width:850px){
  .checkout-flow-3d{grid-template-columns:1fr}
  .payment-choice-grid,.flow-fields{grid-template-columns:1fr}
  .flow-fields label:nth-child(4){grid-column:auto}
}
@media(max-width:650px){
  .auth-3d-card,.flow-glass-card,.payment-glass{padding:23px}
  .auth-3d-card h1{font-size:29px}
  .checkout-flow-3d{width:min(100% - 20px,600px);margin-top:22px}
  .invoice-header,.invoice-bottom,.invoice-meta-grid{grid-template-columns:1fr;display:grid}
  .invoice-title{text-align:left}
  .invoice-page{width:calc(100% - 16px)}
  .professional-invoice{padding:18px}
  .invoice-table{font-size:10px}
  .invoice-table th,.invoice-table td{padding:6px}
  .admin-top-button{padding:7px 9px;font-size:11px}
}
@media print{
  header,.site-footer,.invoice-actions{display:none!important}
  .invoice-page{width:100%;margin:0}
  .professional-invoice{box-shadow:none;border:0}
}