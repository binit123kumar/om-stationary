.hero-premium{position:relative;grid-template-columns:1.1fr .9fr;align-items:center;background:linear-gradient(120deg,#fff7e8 0%,#f2f7ff 66%,#e8f1fb 100%);min-height:370px}.hero-premium .eyebrow,.section-eyebrow{font-size:11px;letter-spacing:1.5px;font-weight:800;color:#b45118}.hero-premium h1{font-size:clamp(36px,4.4vw,56px);letter-spacing:-1.6px}.hero-premium h1 strong{color:#124f91}.hero-premium>div:first-child>p:not(.eyebrow){font-size:16px;max-width:510px}.hero-note{display:flex;align-items:center;gap:7px;color:#51627a;font-size:12px;font-weight:700;margin-top:18px}.hero-art-panel{height:275px;border-radius:24px;background:radial-gradient(circle at 50% 40%,#fff 0 15%,#deebf7 16% 40%,#d3e4f3 41% 100%);display:flex;align-items:center;justify-content:center;position:relative}.hero-monogram{font-size:104px;letter-spacing:-8px;font-weight:950;color:#103e75;text-shadow:0 18px 32px #133b6225}.hero-monogram span{color:#ed761d}.hero-art-label{position:absolute;bottom:21px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:7px;white-space:nowrap;background:#fff;border:1px solid #e4eaf0;padding:10px 14px;border-radius:999px;font-size:12px;font-weight:750;box-shadow:0 8px 22px #12335512}.section-eyebrow{display:block;margin:0 0 3px}.rowhead h2{margin:4px 0 14px}.cats a{display:flex;align-items:center;gap:8px}.card{box-shadow:0 2px 10px #17203308;transition:transform .16s ease,box-shadow .16s ease}.card:hover{transform:translateY(-2px);box-shadow:0 12px 30px #17203314}.card-image{display:block;background:#edf2f6}.image-placeholder{min-height:190px;display:grid;place-items:center;background:linear-gradient(135deg,#edf3f8,#dce7f1);color:#8ba0b5}.image-placeholder svg{width:38px;height:38px}.card-price{display:flex;align-items:baseline;gap:7px;flex-wrap:wrap}.discount{font-size:10px;color:#16803c;font-weight:800}.stock-note{font-size:10px;color:#718096;min-height:27px;margin:8px 0 0;line-height:1.4}.card-view{display:flex;align-items:center;justify-content