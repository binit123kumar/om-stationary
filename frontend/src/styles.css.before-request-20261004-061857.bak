adius:18px;text-align:center;padding:90px 20px}.empty svg{color:#0a67c7}.empty p{color:#718096}.track{max-width:700px;background:#fff;border:1px solid #e8edf4;border-radius:18px;padding:30px}.status{display:flex;gap:18px;position:relative;padding-bottom:30px}.status:not(:last-child):before{content:'';position:absolute;left:6px;top:15px;width:2px;height:100%;background:#dfe6ef}.dot{width:14px;height:14px;border-radius:50%;background:#d8e0eb;z-index:1}.dot.active{background:#0b67cf;box-shadow:0 0 0 5px #eaf3ff}.status b,.status span{display:block}.status span{font-size:12px;color:#77869b;margin-top:5px}.account{max-width:520px;margin:40px auto}.account .outline{width:100%;margin-top:10px}.account .btn{width:100%}footer{background:#0e1e35;color:#fff;display:flex;justify-content:center;gap:35px;padding:28px;font-size:12px}@media(max-width:1000px){.grid{grid-template-columns:repeat(3,1fr)}.deliver{display:none}.hero{grid-template-columns:1fr}.heroart{display:none}.trust{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.top{gap:10px;flex-wrap:wrap}.logo{font-size:18px}.search{order:5;flex-basis:100%}.headlink{font-size:0}.headlink svg{width:20px}.grid{grid-template-columns:repeat(2,1fr)}.hero{padding:30px 22px}.hero h1{font-size:35px}.trust{grid-template-columns:1fr 1fr}.product,.cartlayout,.checkout{grid-template-columns:1fr}.product h1{font-size:30px}.cartitem{grid-template-columns:65px 1fr auto}.cartitem img{width:65px;height:65px}footer{flex-direction:column;align-items:center;gap:10px}}
