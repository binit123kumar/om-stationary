tem{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #eef1f5;font-size:13px}.tracking-total{font-size:17px;font-weight:850;border:0}.checkout-main>h3{margin-top:23px}.checkout-steps{display:flex;gap:18px;border-bottom:1px solid #e9edf2;padding:0 0 15px}.step{display:flex;align-items:center;gap:7px;color:#8a96a5;font-size:12px}.step.active{color:#16589b}.step:first-letter{border-radius:50%}.fulfillment-choice{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0}.choice{position:relative;display:flex!important;align-items:center;gap:11px;border:1px solid #dfe6ee;border-radius:12px;padding:14px;cursor:pointer}.choice.selected{border-color:#1d68ab;background:#f2f8fe}.choice input{width:auto!important;margin:0}.choice>svg{color:#1d68ab;width:19px}.choice span b,.choice span small{display:block}.choice span small{margin-top:4px;color:#718096;font-size:11px}.address-fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field-label{display:block;font-size:12px;font-weight:750;color:#42536a}.field-label input,.field-label select{display:block;width:100%;margin-top:6px}.cod-note{display:flex;align-items:flex-start;gap:10px;background:#f1f8f3;padding:13px;border-radius:10px;color:#227345}.cod-note b,.cod-note small{display:block}.cod-note small{color:#587362;font-size:11px;margin-top:4px}.order-lookup{text-align:center}.order-lookup>svg{color:#1b66aa}.order-lookup form{text-align:left;margin:20px 0}.order-lookup>a{font-size:13px;color:#1a5b99}.admin-orders{margin:20px 0}.admin-order{border-top:1px solid #e9edf2;padding:16px 0}.admin-order-head{display:flex;justify-content:space-between;gap:16px}.admin-order-head>div{display:flex;flex-direction:column;gap:5px}.admin-order-head>div:last-child{text-align:right}.admin-order-head span,.admin-order p{font-size:12px;color:#68788d}.admin-order-controls{display:flex;gap:12px;align-items:end}.admin-order-controls>.field-label{min-width:190px}.assign-form{dis