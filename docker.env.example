# Copy to .env and fill in every required value from a secret manager before deployment.
MSSQL_SA_PASSWORD=
OM_JWT_SIGNING_KEY=
OM_STORE_ORIGIN=
TLS_CERT_DIR=

# Optional one-time admin bootstrap. Leave blank after the owner admin account exists.
OM_ADMIN_EMAIL=
OM_ADMIN_PASSWORD=
OM_ADMIN_PHONE=
OM_ADMIN_NOTIFICATION_EMAIL=
OM_ADMIN_NOTIFICATION_PHONE=

# Production integrations are off until verified provider values are supplied.
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=UPI
PAYMENTS_UPI_VPA=
PAYMENTS_UPI_PAYEE_NAME=OM Stationary
DELIVERY_ENABLED=false
OM_PICKUP_ADDRESS=
